# One of these is required for @vercel/flags-core to reach a real Edge Config.
# EDGE_CONFIG is the connection string form; FLAGS is the hosted-flags form.
EDGE_CONFIG=
FLAGS=

# @vercel/oidc reads this. Outside Vercel there is no ambient token —
# `vercel env pull` writes a short-lived one, so a CI-persistent run likely
# needs a static credential path instead (design §7).
VERCEL_OIDC_TOKEN=

# The flag key to resolve. Must exist in the Edge Config above.
SMOKE_FLAG_KEY=
